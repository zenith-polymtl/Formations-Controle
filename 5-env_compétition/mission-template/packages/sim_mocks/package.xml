<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sim_mocks</name>
  <version>1.0.0</version>
  <description>Ce qui remplace le matériel en simulation : manette (rc_simulator), détections (target_mock), et les nœuds de test qui arment (takeoff_test). Jamais lancés en vol.</description>
  <maintainer email="controle@zenith-polymtl.ca">Zenith, équipe contrôle</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

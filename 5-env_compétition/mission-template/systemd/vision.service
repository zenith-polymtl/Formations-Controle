# Conteneur vision au boot. Même chose que `make vision`, emballé par systemd.
# __REPO__ est remplacé par le chemin du dépôt par `make deploy`.
[Unit]
Description=Vision GPU (docker compose)
After=docker.service network-online.target lo-multicast.service zed.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=__REPO__
ExecStart=/usr/bin/docker compose -f compose/vision.yml up
ExecStop=/usr/bin/docker compose -f compose/vision.yml down
Restart=always
RestartSec=2
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

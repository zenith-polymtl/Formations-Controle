+"""Launch file de la mission démo : la node de mission, le moniteur du projet 5.3, et deux
+fichiers de configuration du repo.
 
 `config/demo.yaml` et `config/sites/<site>.yaml` sont tous deux au format paramètres ROS 2 :
-ils se passent tels quels à la node, sans lecture YAML ici. Les clés imbriquées du site
-(`target: {north_m: ...}`) arrivent à la node sous les noms `target.north_m`, `target.east_m`
-et `altitude_agl`.
+ils se passent tels quels aux nodes, sans lecture YAML ici. `config/demo.yaml` est indexé par
+nom de node, et il porte une section par node (`demo_mission:` et `mission_monitor:`). Les clés
+imbriquées du site (`target: {north_m: ...}`) arrivent à la node de mission sous les noms
+`target.north_m`, `target.east_m` et `altitude_agl`.
 """
 
 from launch import LaunchDescription
@@ -34,8 +36,19 @@ def generate_launch_description():
             {'sim': ParameterValue(LaunchConfiguration('sim'), value_type=bool)},
         ],
     )
+    # Le moniteur du projet 5.3 : il ne fait que regarder, il part et s'arrête avec la mission.
+    # Il reçoit le même config/demo.yaml, où il lit sa propre section `mission_monitor:` ; les
+    # paramètres du site ne le concernent pas.
+    monitor = Node(
+        package='demo_monitor',
+        executable='monitor',
+        name='mission_monitor',
+        output='screen',
+        parameters=[f'{CONFIG_DIR}/demo.yaml'],
+    )
 
     ld.add_action(sim)
     ld.add_action(site)
     ld.add_action(mission)
+    ld.add_action(monitor)
